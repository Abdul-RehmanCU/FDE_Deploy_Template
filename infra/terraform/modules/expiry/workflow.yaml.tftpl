main:
  params: [args]
  steps:
    - load_manifest:
        assign:
          - manifest: ${manifest_json}
          - expected_sha: $${sys.get_env("MANIFEST_SHA")}
          - mode: $${default(map.get(args, "mode"), "sentinel")}
          - supplied_sha: $${default(map.get(args, "manifest_sha"), "")}
    - validate_target:
        switch:
          - condition: $${supplied_sha != expected_sha}
            raise: "manifest fingerprint mismatch"
          - condition: $${manifest.project_id != sys.get_env("GOOGLE_CLOUD_PROJECT_ID")}
            raise: "compiled project does not match workflow project"
          - condition: $${not(mode in ["sentinel", "dry-run", "cleanup", "recovery"])}
            raise: "unsupported cleanup mode"
    - read_project:
        try:
          call: http.get
          args:
            url: $${"https://cloudresourcemanager.googleapis.com/v3/projects/" + manifest.project_id}
            auth: { type: OAuth2 }
          result: project_result
        retry: $${http.default_retry}
    - validate_project_number:
        switch:
          - condition: $${project_result.body.name != "projects/" + manifest.project_number}
            raise: "compiled project number does not match live project"
    - log_target:
        call: sys.log
        args:
          severity: NOTICE
          text: $${"FDE expiry target=" + manifest.project_id + " manifest=" + expected_sha + " mode=" + mode}
    - stop_probe:
        switch:
          - condition: $${mode in ["sentinel", "dry-run"]}
            return:
              status: "sentinel-ok"
              manifest_sha: $${expected_sha}
              project_number: $${project_result.body.name}
              expiry_id: $${manifest.expiry_id}
          - condition: $${mode in ["cleanup", "recovery"] and sys.now() < time.parse(manifest.expires_at)}
            return:
              status: "not-due"
              manifest_sha: $${expected_sha}
    - init_results:
        assign:
          - cleanup_results: []
    - delete_cluster:
        call: delete_gke_cluster
        args:
          project: $${manifest.project_id}
          zone: $${manifest.zone}
          name: $${manifest.cluster_name}
          expiry_id: $${manifest.expiry_id}
        result: cluster_result
    - record_cluster:
        assign:
          - cleanup_results: $${list.concat(cleanup_results, cluster_result)}
    - delete_disks:
        for:
          value: disk
          in: $${manifest.disk_resources}
          steps:
            - delete_one_disk:
                call: delete_compute_resource
                args:
                  project: $${manifest.project_id}
                  scope_kind: "zones"
                  scope_name: $${manifest.zone}
                  collection: "disks"
                  name: $${disk.name}
                  expected_expiry_id: $${disk.expiry_id}
                  creation_timestamp: null
                result: disk_result
            - record_disk:
                assign:
                  - cleanup_results: $${list.concat(cleanup_results, disk_result)}
    - delete_addresses:
        for:
          value: address
          in: $${manifest.address_resources}
          steps:
            - delete_one_address:
                call: delete_compute_resource
                args:
                  project: $${manifest.project_id}
                  scope_kind: "regions"
                  scope_name: $${manifest.region}
                  collection: "addresses"
                  name: $${address.name}
                  expected_expiry_id: null
                  creation_timestamp: $${address.creation_timestamp}
                result: address_result
            - record_address:
                assign:
                  - cleanup_results: $${list.concat(cleanup_results, address_result)}
    - empty_buckets:
        for:
          value: bucket
          in: $${manifest.bucket_names}
          steps:
            - empty_one_bucket:
                call: empty_bucket
                args:
                  bucket: $${bucket}
                  expiry_id: $${manifest.expiry_id}
                result: bucket_result
            - record_bucket:
                assign:
                  - cleanup_results: $${list.concat(cleanup_results, bucket_result)}
    - delete_artifact_repository:
        call: delete_repository
        args:
          project: $${manifest.project_id}
          region: $${manifest.region}
          repository: $${manifest.artifact_repository}
          expiry_id: $${manifest.expiry_id}
        result: repository_result
    - record_repository:
        assign:
          - cleanup_results: $${list.concat(cleanup_results, repository_result)}
    - incomplete:
        switch:
          - condition: $${"ownership-mismatch" in cleanup_results}
            return:
              status: "cleanup-incomplete"
              manifest_sha: $${expected_sha}
              results: $${cleanup_results}
    - complete:
        return:
          status: "cleanup-complete"
          manifest_sha: $${expected_sha}
          results: $${cleanup_results}

delete_gke_cluster:
  params: [project, zone, name, expiry_id]
  steps:
    - read_resource:
        try:
          call: http.get
          args:
            url: $${"https://container.googleapis.com/v1/projects/" + project + "/zones/" + zone + "/clusters/" + name}
            auth: { type: OAuth2 }
          result: existing
        retry: $${http.default_retry}
        except:
          as: e
          steps:
            - tolerate_missing_read:
                switch:
                  - condition: $${e.code == 404}
                    return: "already-absent"
                  - condition: true
                    raise: $${e}
    - verify_owner:
        switch:
          - condition: $${map.get(existing.body, ["resourceLabels", "expiry-id"]) != expiry_id}
            return: "ownership-mismatch"
    - request_delete:
        try:
          call: http.delete
          args:
            url: $${"https://container.googleapis.com/v1/projects/" + project + "/zones/" + zone + "/clusters/" + name}
            auth: { type: OAuth2 }
          result: deletion
        retry: $${http.default_retry}
        except:
          as: e
          steps:
            - tolerate_missing:
                switch:
                  - condition: $${e.code == 404}
                    return: "already-absent"
                  - condition: true
                    raise: $${e}
    - init_poll:
        assign:
          - polls: 0
    - poll:
        try:
          call: http.get
          args:
            url: $${"https://container.googleapis.com/v1/projects/" + project + "/zones/" + zone + "/operations/" + deletion.body.name}
            auth: { type: OAuth2 }
          result: operation
        retry: $${http.default_retry}
    - check:
        switch:
          - condition: $${operation.body.status == "DONE" and map.get(operation.body, "error") != null}
            raise: $${operation.body.error}
          - condition: $${operation.body.status == "DONE"}
            return: "deleted"
          - condition: $${polls >= 119}
            raise: "GKE deletion exceeded ten minutes"
    - wait:
        call: sys.sleep
        args: { seconds: 5 }
        next: increment
    - increment:
        assign:
          - polls: $${polls + 1}
        next: poll

delete_compute_resource:
  params: [project, scope_kind, scope_name, collection, name, expected_expiry_id, creation_timestamp]
  steps:
    - read_resource:
        try:
          call: http.get
          args:
            url: $${"https://compute.googleapis.com/compute/v1/projects/" + project + "/" + scope_kind + "/" + scope_name + "/" + collection + "/" + name}
            auth: { type: OAuth2 }
          result: existing
        retry: $${http.default_retry}
        except:
          as: e
          steps:
            - tolerate_missing_read:
                switch:
                  - condition: $${e.code == 404}
                    return: "already-absent"
                  - condition: true
                    raise: $${e}
    - verify_fingerprint:
        switch:
          - condition: $${expected_expiry_id != null and map.get(existing.body, ["labels", "expiry-id"]) != expected_expiry_id}
            return: "ownership-mismatch"
          - condition: $${creation_timestamp != null and existing.body.creationTimestamp != creation_timestamp}
            return: "ownership-mismatch"
    - request_delete:
        try:
          call: http.delete
          args:
            url: $${"https://compute.googleapis.com/compute/v1/projects/" + project + "/" + scope_kind + "/" + scope_name + "/" + collection + "/" + name}
            auth: { type: OAuth2 }
          result: deletion
        retry: $${http.default_retry}
        except:
          as: e
          steps:
            - tolerate_missing:
                switch:
                  - condition: $${e.code == 404}
                    return: "already-absent"
                  - condition: true
                    raise: $${e}
    - init_poll:
        assign:
          - polls: 0
    - poll:
        try:
          call: http.get
          args:
            url: $${"https://compute.googleapis.com/compute/v1/projects/" + project + "/" + scope_kind + "/" + scope_name + "/operations/" + deletion.body.name}
            auth: { type: OAuth2 }
          result: operation
        retry: $${http.default_retry}
    - check:
        switch:
          - condition: $${operation.body.status == "DONE" and map.get(operation.body, "error") != null}
            raise: $${operation.body.error}
          - condition: $${operation.body.status == "DONE"}
            return: "deleted"
          - condition: $${polls >= 119}
            raise: "Compute deletion exceeded ten minutes"
    - wait:
        call: sys.sleep
        args: { seconds: 5 }
        next: increment
    - increment:
        assign:
          - polls: $${polls + 1}
        next: poll

empty_bucket:
  params: [bucket, expiry_id]
  steps:
    - read_bucket:
        try:
          call: http.get
          args:
            url: $${"https://storage.googleapis.com/storage/v1/b/" + bucket}
            auth: { type: OAuth2 }
          result: existing_bucket
        retry: $${http.default_retry}
        except:
          as: e
          steps:
            - tolerate_missing_bucket_read:
                switch:
                  - condition: $${e.code == 404}
                    return: "already-absent"
                  - condition: true
                    raise: $${e}
    - verify_bucket_owner:
        switch:
          - condition: $${map.get(existing_bucket.body, ["labels", "expiry-id"]) != expiry_id}
            return: "ownership-mismatch"
    - initialise:
        assign:
          - rounds: 0
    - list_first_page:
        try:
          call: http.get
          args:
            url: $${"https://storage.googleapis.com/storage/v1/b/" + bucket + "/o"}
            query: { maxResults: 1000, versions: true }
            auth: { type: OAuth2 }
          result: listed
        retry: $${http.default_retry}
        except:
          as: e
          steps:
            - missing_bucket_is_done:
                switch:
                  - condition: $${e.code == 404}
                    return: "already-absent"
                  - condition: true
                    raise: $${e}
    - delete_objects:
        for:
          value: object
          in: $${default(map.get(listed.body, "items"), [])}
          steps:
            - delete_one_object:
                call: delete_gcs_object
                args:
                  bucket: $${bucket}
                  name: $${object.name}
                  generation: $${object.generation}
    - repeat_or_delete:
        switch:
          - condition: $${len(default(map.get(listed.body, "items"), [])) > 0 and rounds < 100}
            next: wait_for_listing
          - condition: $${rounds >= 100}
            raise: "bucket did not empty after 100 bounded rounds"
    - delete_bucket:
        try:
          call: http.delete
          args:
            url: $${"https://storage.googleapis.com/storage/v1/b/" + bucket}
            auth: { type: OAuth2 }
        retry: $${http.default_retry}
        except:
          as: e
          steps:
            - tolerate_missing_bucket:
                switch:
                  - condition: $${e.code == 404}
                    return: "already-absent"
                  - condition: $${e.code == 409 and rounds < 100}
                    next: wait_for_listing
                  - condition: true
                    raise: $${e}
    - bucket_done:
        return: "deleted"
    - wait_for_listing:
        call: sys.sleep
        args: { seconds: 2 }
        next: increment_round
    - increment_round:
        assign:
          - rounds: $${rounds + 1}
        next: list_first_page

delete_gcs_object:
  params: [bucket, name, generation]
  steps:
    - delete:
        try:
          call: http.delete
          args:
            url: $${"https://storage.googleapis.com/storage/v1/b/" + bucket + "/o/" + text.url_encode(name)}
            query:
              generation: $${generation}
            auth: { type: OAuth2 }
        retry: $${http.default_retry}
        except:
          as: e
          steps:
            - tolerate_missing:
                switch:
                  - condition: $${e.code == 404}
                    return: "already-absent"
                  - condition: true
                    raise: $${e}
    - done:
        return: "deleted"

delete_repository:
  params: [project, region, repository, expiry_id]
  steps:
    - read_repository:
        try:
          call: http.get
          args:
            url: $${"https://artifactregistry.googleapis.com/v1/projects/" + project + "/locations/" + region + "/repositories/" + repository}
            auth: { type: OAuth2 }
          result: existing_repository
        retry: $${http.default_retry}
        except:
          as: e
          steps:
            - tolerate_missing_repository_read:
                switch:
                  - condition: $${e.code == 404}
                    return: "already-absent"
                  - condition: true
                    raise: $${e}
    - verify_repository_owner:
        switch:
          - condition: $${map.get(existing_repository.body, ["labels", "expiry-id"]) != expiry_id}
            return: "ownership-mismatch"
    - request_delete:
        try:
          call: http.delete
          args:
            url: $${"https://artifactregistry.googleapis.com/v1/projects/" + project + "/locations/" + region + "/repositories/" + repository}
            auth: { type: OAuth2 }
          result: deletion
        retry: $${http.default_retry}
        except:
          as: e
          steps:
            - tolerate_missing:
                switch:
                  - condition: $${e.code == 404}
                    return: "already-absent"
                  - condition: true
                    raise: $${e}
    - init_poll:
        assign:
          - polls: 0
    - poll:
        try:
          call: http.get
          args:
            url: $${"https://artifactregistry.googleapis.com/v1/" + deletion.body.name}
            auth: { type: OAuth2 }
          result: operation
        retry: $${http.default_retry}
    - check:
        switch:
          - condition: $${default(map.get(operation.body, "done"), false) and map.get(operation.body, "error") != null}
            raise: $${operation.body.error}
          - condition: $${default(map.get(operation.body, "done"), false)}
            return: "deleted"
          - condition: $${polls >= 119}
            raise: "Artifact Registry deletion exceeded ten minutes"
    - wait:
        call: sys.sleep
        args: { seconds: 5 }
        next: increment
    - increment:
        assign:
          - polls: $${polls + 1}
        next: poll
