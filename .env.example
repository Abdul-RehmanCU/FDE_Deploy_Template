# Local development only. Copy to .env and replace every generated placeholder.
FASTAPI_ENV=development
PROJECT_NAME="FDE Deployment Template"
SECRET_KEY=generate-a-random-local-secret
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=generate-a-random-local-password
POSTGRES_PASSWORD=generate-a-random-local-password
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/app
FRONTEND_HOST=http://localhost:5173

# Email delivery is intentionally disabled in this project.
SMTP_HOST=
EMAILS_FROM_EMAIL=
